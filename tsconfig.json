{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "paths": {
      "@openmfp/webcomponents/declarative-ui": [
        "./projects/ngx/declarative-ui/public-api.ts"
      ],
      "@openmfp/webcomponents/declarative-ui/dashboard": [
        "./projects/ngx/declarative-ui/dashboard/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "exclude": ["vitest.config.ts", "e2e"],
  "references": [
    {
      "path": "./projects/ngx/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx/declarative-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx/declarative-ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/ngx/cards/tsconfig.spec.json"
    }
  ]
}
