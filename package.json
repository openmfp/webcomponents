{
  "name": "@openmfp/webcomponents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ngx": "ng build ngx",
    "build:wc": "ng build webcomponents && node scripts/bundle-wc.mjs",
    "build": "npm run build:ngx && npm run build:wc",
    "build:watch": "mkdirp dist && nodemon --ignore dist --ignore public --ext js,yml,yaml,ts,html,css,scss,json,md --exec \"rimraf dist && npm run build && yalc publish dist/ngx --push --sig\"",
    "test": "ng test ngx --watch=false",
    "test:watch": "ng test ngx",
    "test:cov": "ng test ngx --watch=false --coverage",
    "storybook": "ng run ngx:storybook",
    "build:storybook": "ng run ngx:build-storybook",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier . --write --list-different",
    "check-format": "prettier . --check"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "gridstack": "^12.6.0",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@fundamental-ngx/ui5-webcomponents": "^0.61.0",
    "@fundamental-ngx/ui5-webcomponents-fiori": "^0.61.0",
    "jsonpath": "^1.1.1",
    "rxjs": "^7.8.2"
  },
  "prettier": "@openmfp/config-prettier",
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.6",
    "@angular-eslint/builder": "^21.3.1",
    "@angular/build": "^21.2.6",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.7",
    "@compodoc/compodoc": "^1.2.1",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.11",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-links": "^10.2.16",
    "@storybook/angular": "^10.2.16",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.4",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "jsdom": "29.0.2",
    "ng-packagr": "^21.1.0",
    "nodemon": "3.1.14",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "storybook": "^10.2.16",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "4.1.4",
    "wait-on": "9.0.4"
  },
  "overrides": {
    "underscore": "1.13.8"
  }
}
